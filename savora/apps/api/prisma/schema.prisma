generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  password           String
  onboardingComplete Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  dietaryProfile         DietaryProfile?
  culinaryIdentityGenome CulinaryIdentityGenome?
  flavorGenome           FlavorGenome?
  recipeHistory          RecipeHistory[]
  favorites              Favorite[]
  subscription           Subscription?
  genomeSnapshots        GenomeSnapshot[]
  mealLogs               MealLog[]
  shoppingList           ShoppingList?
  communityPosts         CommunityPost[]
  communityReplies       CommunityReply[]
  restaurantReviews      RestaurantReview[]
}

model DietaryProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  restrictions String[]
  dislikes     String[]
  user         User     @relation(fields: [userId], references: [id])
}

model CulinaryIdentityGenome {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  identityTitle              String
  identitySubtitle           String
  cuisineAffinity            String[]
  adventurousness            Float
  comfortVsNovelty           Float
  luxuryVsRustic             Float
  complexityTolerance        Float
  socialVsSolitary           Float
  ritualVsSpontaneity        Float
  finingDiningAffinity       Float
  diningAtmospherePreference String[]
  moodFoodRelationship       String
  evolutionNote              String
  updatedAt                  DateTime @updatedAt
  user                       User     @relation(fields: [userId], references: [id])
}

model FlavorGenome {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  saltScore              Float
  sweetScore             Float
  bitterScore            Float
  acidityScore           Float
  heatScore              Float
  aromaticSpiceScore     Float
  umamiScore             Float
  fatRichnessScore       Float
  smokeCharScore         Float
  fermentationScore      Float
  mineralCleanScore      Float
  aromaticIntensityScore Float
  dominantFlavors        String[]
  flavorPersonality      String
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id])
}

model GeneratedRecipe {
  id                 String   @id @default(cuid())
  userId             String
  title              String
  description        String
  mood               String
  cuisineInspiration String
  dietaryType        String
  ingredients        Json
  steps              Json
  prepTime           Int
  cookTime           Int
  totalTime          Int
  difficulty         String
  platingSuggestion  String
  pairingSuggestion  String
  whyThisFits        String
  flavorProfile      Json
  fingerprint        Json
  source             String   @default("mood")
  createdAt          DateTime @default(now())
  history            RecipeHistory?
}

model RecipeHistory {
  id        String          @id @default(cuid())
  userId    String
  recipeId  String          @unique
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id])
  recipe    GeneratedRecipe @relation(fields: [recipeId], references: [id])
}

model Favorite {
  id       String   @id @default(cuid())
  userId   String
  itemType String
  itemId   String
  metadata Json?
  savedAt  DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id])
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  status           String    @default("free")
  stripeCustomerId String?
  renewalDate      DateTime?
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id])
}

model GenomeSnapshot {
  id        String   @id @default(cuid())
  userId    String
  type      String
  data      Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model MealLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  recipeId   String?
  recipeName String
  moodTag    String?
  notes      String?
  loggedAt   DateTime @default(now())
  createdAt  DateTime @default(now())
}

model DailyUsage {
  id                String @id @default(cuid())
  userId            String
  date              String
  recipeGenerations Int    @default(0)
  citySearches      Int    @default(0)

  @@unique([userId, date])
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  city      String
  createdAt DateTime @default(now())
}

model ShoppingList {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  items     ShoppingItem[]
}

model ShoppingItem {
  id             String       @id @default(cuid())
  listId         String
  list           ShoppingList @relation(fields: [listId], references: [id])
  name           String
  amount         String?
  unit           String?
  category       String?
  isChecked      Boolean      @default(false)
  sourceRecipeId String?
  sourceTitle    String?
  createdAt      DateTime     @default(now())
}

model PlacesCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  city      String
  query     String
  data      Json
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model CommunityPost {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  identitySlug String
  type         String
  title        String?
  body         String
  cityRef      String?
  restaurantRef String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  replies      CommunityReply[]
}

model CommunityReply {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id])
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  body      String
  createdAt DateTime      @default(now())
}

model RestaurantReview {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  restaurantName   String
  restaurantCity   String
  placeId          String?
  body             String
  visitedAt        DateTime?
  culinaryIdentity String
  createdAt        DateTime  @default(now())
}

model ContentReport {
  id         String   @id @default(cuid())
  reporterId String
  targetType String
  targetId   String
  reason     String?
  createdAt  DateTime @default(now())
}

model IngredientSourcingCache {
  id           String   @id @default(cuid())
  ingredientKey String  @unique
  data         Json
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}
